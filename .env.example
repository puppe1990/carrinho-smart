# Better Auth — use um segredo longo e aleatório (mínimo 32 caracteres)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars

# URL base da aplicação (usada pelo Better Auth)
BETTER_AUTH_URL=http://localhost:3000

# Arquivo do banco SQLite
DATABASE_URL=data/carrinhosmart.db

# Semente determinística do seed (faker)
SEED=42
